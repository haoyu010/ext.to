# Build output. These must be anchored to the repository root: an unanchored
# "server" rule would also match the cmd/server source directory.
/server
/server.exe
*.exe
/out/

# Runtime data (settings, history) — never commit secrets or state
/data/
/smoke-data/
config.json
state.json

# Local scratch from development
*.html
!internal/web/assets/*.html
!internal/scrape/testdata/*.html
*.json
!go.mod
!go.sum
*.py
*.txt
go-probe/
screen*.png
crop*.png

# Browser profiles captured while harvesting a clearance cookie
/browser-profile/
/chrome-profile/
/probe/

# Editors and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
